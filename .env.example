# Kopieer dit bestand naar .env.local en vul je eigen Supabase-gegevens in.
# Gebruik hier ALLEEN de publieke "anon"-sleutel, nooit de service_role/secret key.
VITE_SUPABASE_URL=https://jouw-project.supabase.co
VITE_SUPABASE_ANON_KEY=jouw-anon-public-key
# Naam van de tabel met evenementen (standaard: events)
VITE_EVENTS_TABLE=events
